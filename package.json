{
  "name": "sgf-highlighter",
  "displayName": "SGF Highlighter",
  "description": "Syntax highlighting for Smart Game Format (SGF)",
  "version": "0.1.0",
  "publisher": "hemme",
  "engines": {
    "vscode": "^1.115.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hemme/vscode_sgf.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:sgf"
  ],
  "contributes": {
    "languages": [{
      "id": "sgf",
      "aliases": ["Smart Game Format", "sgf"],
      "extensions": [".sgf"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "sgf",
      "scopeName": "source.sgf",
      "path": "./syntaxes/sgf.tmLanguage.json"
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.115.0",
    "typescript": "^5.8.0"
  }
}
