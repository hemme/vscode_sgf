{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Smart Game Format",
	"patterns": [
		{ "include": "#game-tree" },
		{ "include": "#node-separator" },
		{ "include": "#property-black" },
		{ "include": "#property-white" },
		{ "include": "#property-comment" },
		{ "include": "#property-game-info" },
		{ "include": "#property-markup" },
		{ "include": "#property-annotation" },
		{ "include": "#property-generic" }
	],
	"repository": {
		"game-tree": {
			"patterns": [
				{
					"name": "punctuation.definition.game-tree.begin.sgf",
					"match": "\\("
				},
				{
					"name": "punctuation.definition.game-tree.end.sgf",
					"match": "\\)"
				}
			]
		},
		"node-separator": {
			"name": "punctuation.separator.node.sgf",
			"match": ";"
		},
		"property-black": {
			"begin": "\\b(B|AB|TB|PB|BR)\\b(?=\\[)",
			"beginCaptures": { "1": { "name": "entity.name.type.class.sgf" } },
			"end": "(?=[A-Z]{1,2}(?=\\[)|;|\\(|\\))",
			"patterns": [
				{
					"begin": "\\[",
					"beginCaptures": { "0": { "name": "entity.name.type.class.sgf" } },
					"end": "\\]",
					"endCaptures": { "0": { "name": "entity.name.type.class.sgf" } },
					"contentName": "string.other.property-value.sgf",
					"patterns": [ { "match": "\\\\.", "name": "constant.character.escape.sgf" } ]
				}
			]
		},
		"property-white": {
			"begin": "\\b(W|AW|TW|PW|WR)\\b(?=\\[)",
			"beginCaptures": { "1": { "name": "keyword.control.sgf" } },
			"end": "(?=[A-Z]{1,2}(?=\\[)|;|\\(|\\))",
			"patterns": [
				{
					"begin": "\\[",
					"beginCaptures": { "0": { "name": "keyword.control.sgf" } },
					"end": "\\]",
					"endCaptures": { "0": { "name": "keyword.control.sgf" } },
					"contentName": "string.other.property-value.sgf",
					"patterns": [ { "match": "\\\\.", "name": "constant.character.escape.sgf" } ]
				}
			]
		},
		"property-comment": {
			"begin": "\\b(C)\\b(?=\\[)",
			"beginCaptures": { "1": { "name": "entity.name.tag.annotation.sgf" } },
			"end": "(?=[A-Z]{1,2}(?=\\[)|;|\\(|\\))",
			"patterns": [
				{
					"begin": "\\[",
					"beginCaptures": { "0": { "name": "entity.name.tag.annotation.sgf" } },
					"end": "\\]",
					"endCaptures": { "0": { "name": "entity.name.tag.annotation.sgf" } },
					"contentName": "comment.block.sgf",
					"patterns": [ { "match": "\\\\.", "name": "constant.character.escape.sgf" } ]
				}
			]
		},
		"property-game-info": {
			"begin": "\\b(AN|AP|BT|CA|CP|DT|EV|FF|GC|GM|GN|HA|KM|ON|OT|PC|RE|RO|RU|SI|SO|ST|SZ|TM|US|WT)\\b(?=\\[)",
			"beginCaptures": { "1": { "name": "constant.other.game-info.sgf" } },
			"end": "(?=[A-Z]{1,2}(?=\\[)|;|\\(|\\))",
			"patterns": [
				{
					"begin": "\\[",
					"beginCaptures": { "0": { "name": "constant.other.game-info.sgf" } },
					"end": "\\]",
					"endCaptures": { "0": { "name": "constant.other.game-info.sgf" } },
					"contentName": "string.other.property-value.sgf",
					"patterns": [ { "match": "\\\\.", "name": "constant.character.escape.sgf" } ]
				}
			]
		},
		"property-markup": {
			"begin": "\\b(AR|CR|DD|LB|LN|MA|SQ|TR)\\b(?=\\[)",
			"beginCaptures": { "1": { "name": "variable.annotation.markup.sgf" } },
			"end": "(?=[A-Z]{1,2}(?=\\[)|;|\\(|\\))",
			"patterns": [
				{
					"begin": "\\[",
					"beginCaptures": { "0": { "name": "variable.annotation.markup.sgf" } },
					"end": "\\]",
					"endCaptures": { "0": { "name": "variable.annotation.markup.sgf" } },
					"contentName": "string.other.property-value.sgf",
					"patterns": [ { "match": "\\\\.", "name": "constant.character.escape.sgf" } ]
				}
			]
		},
		"property-annotation": {
			"begin": "\\b(BM|DO|IT|TE|DM|GB|GW|UC|N|AE)\\b(?=\\[)",
			"beginCaptures": { "1": { "name": "support.function.annotation.sgf" } },
			"end": "(?=[A-Z]{1,2}(?=\\[)|;|\\(|\\))",
			"patterns": [
				{
					"begin": "\\[",
					"beginCaptures": { "0": { "name": "support.function.annotation.sgf" } },
					"end": "\\]",
					"endCaptures": { "0": { "name": "support.function.annotation.sgf" } },
					"contentName": "string.other.property-value.sgf",
					"patterns": [ { "match": "\\\\.", "name": "constant.character.escape.sgf" } ]
				}
			]
		},
		"property-generic": {
			"begin": "\\b([A-Z]{1,2})\\b(?=\\[)",
			"beginCaptures": { "1": { "name": "variable.other.property.sgf" } },
			"end": "(?=[A-Z]{1,2}(?=\\[)|;|\\(|\\))",
			"patterns": [
				{
					"begin": "\\[",
					"beginCaptures": { "0": { "name": "variable.other.property.sgf" } },
					"end": "\\]",
					"endCaptures": { "0": { "name": "variable.other.property.sgf" } },
					"contentName": "string.other.property-value.sgf",
					"patterns": [ { "match": "\\\\.", "name": "constant.character.escape.sgf" } ]
				}
			]
		}
	},
	"scopeName": "source.sgf"
}
